<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rttsh</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Toolbox.Tools.RttCli</RootNamespace>
    <!-- The tool's own release version, shown by the version flag. -->
    <Version>0.3.6</Version>
    <!-- McpNative's function-pointer ABI and the UnmanagedCallersOnly trampoline. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Builds the Rust glue crates (native/) and ships rttsh_mcp_native.dll,
       rttsh_elf_native.dll and rttsh_lua_native.dll flat next to the managed output.
       Inputs/Outputs let MSBuild skip cargo entirely when the DLLs are newer than
       every Rust source (rttsh-svd is an rlib-only workspace member - it is not
       linked into any DLL, so its sources are deliberately not tracked).
       Escape hatch: -p:RttshSkipNative=true. -->
  <ItemGroup>
    <RttshNativeSources Include="$(RttshNativeDir)rttsh-mcp\src\**\*.rs" />
    <RttshNativeSources Include="$(RttshNativeDir)rttsh-elf\src\**\*.rs" />
    <RttshNativeSources Include="$(RttshNativeDir)rttsh-lua\src\**\*.rs" />
    <Content Include="$(RttshNativeDll)"
             Link="rttsh_mcp_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="$(RttshElfNativeDll)"
             Link="rttsh_elf_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
    <Content Include="$(RttshLuaNativeDll)"
             Link="rttsh_lua_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
  <Target Name="BuildRttshNative"
          BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT' and '$(RttshSkipNative)' != 'true'"
          Inputs="$(RttshNativeDir)Cargo.toml;$(RttshNativeDir)Cargo.lock;$(RttshNativeDir)rttsh-mcp\Cargo.toml;$(RttshNativeDir)rttsh-elf\Cargo.toml;$(RttshNativeDir)rttsh-lua\Cargo.toml;@(RttshNativeSources)"
          Outputs="$(RttshNativeDll);$(RttshElfNativeDll);$(RttshLuaNativeDll)">
    <Exec Command="cargo build --release --manifest-path &quot;$(RttshNativeDir)Cargo.toml&quot;" />
    <ItemGroup>
      <FileWrites Include="$(RttshNativeDll)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\RttSh.Core\RttSh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Lua shim (the rtt.* table) as an assembly resource: rtt_shim.lua is
         the single source, also included by the Rust tests via include_str!. -->
    <EmbeddedResource Include="Scripting\rtt_shim.lua" LogicalName="RttSh.Scripting.rtt_shim.lua" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="rttsh.tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
