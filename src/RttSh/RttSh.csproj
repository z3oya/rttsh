<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rttsh</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Toolbox.Tools.RttCli</RootNamespace>
    <!-- The tool's own release version, shown by the version flag. -->
    <Version>0.3.2</Version>
    <!-- McpNative's function-pointer ABI and the UnmanagedCallersOnly trampoline. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Builds the Rust glue crate (native/) and ships rttsh_mcp_native.dll flat next to
       the managed output, like lua54.dll. Inputs/Outputs let MSBuild skip cargo entirely
       when the DLL is newer than every Rust source. Escape hatch: -p:RttshSkipNative=true. -->
  <ItemGroup>
    <RttshNativeSources Include="$(RttshNativeDir)rttsh-mcp\src\**\*.rs" />
    <Content Include="$(RttshNativeDll)"
             Link="rttsh_mcp_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
  <Target Name="BuildRttshNative"
          BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT' and '$(RttshSkipNative)' != 'true'"
          Inputs="$(RttshNativeDir)Cargo.toml;$(RttshNativeDir)Cargo.lock;@(RttshNativeSources)"
          Outputs="$(RttshNativeDll)">
    <Exec Command="cargo build --release --manifest-path &quot;$(RttshNativeDir)Cargo.toml&quot;" />
    <ItemGroup>
      <FileWrites Include="$(RttshNativeDll)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\RttSh.Core\RttSh.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="rttsh.tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLua" Version="1.7.9" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
