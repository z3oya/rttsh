<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>rttsh.core</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RttSh.Core</RootNamespace>
    <!-- ElfNative's [LibraryImport] surface generates unsafe marshaling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The Elf submodule goes through the Rust glue crate (native/rttsh-elf →
       rttsh_elf_native.dll, shipped by the RttSh build target); this project has
       no package references. -->
  <ItemGroup>
    <InternalsVisibleTo Include="rttsh.tests" />
  </ItemGroup>

</Project>
