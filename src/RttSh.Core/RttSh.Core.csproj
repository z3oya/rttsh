<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>rttsh.core</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RttSh.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only package dependency of Core: the Elf submodule wraps it completely - ELFSharp
         types never appear in Core's public surface. -->
    <PackageReference Include="ELFSharp" Version="2.17.3" />
  </ItemGroup>

</Project>
