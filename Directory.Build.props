<Project>
  <PropertyGroup>
    <CETCompat>false</CETCompat>
    <!-- Rust glue crate (native/): shared paths for the build target and the DLL copies. -->
    <RttshNativeDir>$(MSBuildThisFileDirectory)native\</RttshNativeDir>
    <RttshNativeDll>$(RttshNativeDir)target\release\rttsh_mcp_native.dll</RttshNativeDll>
  </PropertyGroup>
</Project>
